---
import { getCollection } from "astro:content";
import { dict, type Lang } from "../i18n/dict";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang].blog;

const posts = (
  await getCollection("blog", (p) => p.data.lang === lang && !p.data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const dateFmt = (d: Date) =>
  d.toLocaleDateString(lang === "ru" ? "ru-RU" : "en-US", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });

const href = (base: string) => (lang === "ru" ? `/ru${base}` : base);
const postSlug = (id: string) => id.replace(/^(en|ru)\//, "");
---

<section class="container-page py-16 md:py-24 max-w-5xl">
  <div class="mb-12">
    <h2 class="font-mono text-gold text-sm mb-6 tracking-widest uppercase">
      {t.label}
    </h2>
    <h1
      class="text-[16vw] md:text-[10vw] font-display uppercase leading-[0.85] tracking-tighter text-white"
    >
      {t.title}
    </h1>
  </div>

  <div class="flex flex-col border-t border-line w-full">
    {
      posts.map((post) => (
        <a
          href={href(`/blog/${postSlug(post.id)}`)}
          class="group flex flex-col py-8 border-b border-line hover:border-gold transition-colors w-full"
        >
          <div class="flex justify-between items-baseline w-full gap-6">
            <div class="min-w-0">
              <h2 class="text-2xl md:text-4xl font-bold uppercase text-white group-hover:text-gold group-hover:translate-x-4 transition-all duration-300">
                {post.data.title}
              </h2>
              <p class="text-neutral-400 mt-3 max-w-2xl leading-relaxed group-hover:text-neutral-200 transition-colors">
                {post.data.description}
              </p>
              <div class="flex flex-wrap gap-2 mt-4">
                {post.data.tags.map((tag) => (
                  <span class="font-mono text-[10px] text-neutral-500 uppercase tracking-wider">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>
            <span class="font-mono text-neutral-500 text-sm hidden md:block group-hover:text-gold shrink-0">
              {dateFmt(post.data.date)}
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>
