---
import { dict, type Lang } from "../i18n/dict";
import { decisions } from "../data/decisions";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang].decisionsPage;
const c = decisions[lang];
const root = lang === "ru" ? "/ru" : "/";
---

<section class="container-page py-16 md:py-24 max-w-5xl">
  <a
    href={root}
    class="font-mono text-sm text-gold hover:text-white transition-colors tracking-widest"
  >
    {t.back}
  </a>

  <div class="mt-10 mb-12">
    <h2 class="font-mono text-gold text-sm mb-6 tracking-widest uppercase">
      {t.label}
    </h2>
    <h1
      class="text-4xl md:text-6xl font-black uppercase tracking-tight text-white"
    >
      {t.title}
    </h1>
    <p class="text-neutral-400 mt-6 max-w-2xl leading-relaxed text-lg">
      {c.intro}
    </p>
  </div>

  <div class="space-y-6">
    {
      c.items.map((d) => (
        <article class="border border-line bg-black p-6 md:p-8 hover:border-gold transition-colors">
          <div class="flex flex-wrap items-baseline justify-between gap-3 mb-6">
            <span class="font-mono text-gold text-sm tracking-widest">
              {d.id}
            </span>
            <span class="font-mono text-[10px] uppercase tracking-widest text-neutral-500 border border-line px-3 py-1">
              {d.status}
            </span>
          </div>
          <h2 class="text-2xl md:text-3xl font-black uppercase tracking-tight text-white mb-8">
            {d.title}
          </h2>
          <dl class="space-y-5 max-w-3xl">
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-widest text-gold mb-1">
                {c.contextLabel}
              </dt>
              <dd class="text-neutral-300 leading-relaxed">{d.context}</dd>
            </div>
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-widest text-gold mb-1">
                {c.decisionLabel}
              </dt>
              <dd class="text-neutral-200 leading-relaxed">{d.decision}</dd>
            </div>
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-widest text-gold mb-1">
                {c.consequencesLabel}
              </dt>
              <dd class="text-neutral-400 leading-relaxed">{d.consequences}</dd>
            </div>
          </dl>
        </article>
      ))
    }
  </div>
</section>
