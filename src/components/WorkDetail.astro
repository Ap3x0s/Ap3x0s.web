---
import type { Work } from "../data/works";
import { dict, type Lang } from "../i18n/dict";

interface Props {
  work: Work;
  lang: Lang;
}

const { work, lang } = Astro.props;
const t = dict[lang].works;

const worksHref = lang === "ru" ? "/ru/works" : "/works";
---

<section class="container-page py-16 md:py-24 max-w-5xl">
  <a
    href={worksHref}
    class="font-mono text-sm text-gold hover:text-white transition-colors tracking-widest"
  >
    {t.back}
  </a>

  <div class="mt-10 flex flex-col md:flex-row md:items-start justify-between gap-6">
    <div class="min-w-0">
      <div class="font-mono text-xs text-neutral-500 uppercase tracking-widest">
        {work.tags.join(" / ")}
      </div>
      <h1
        class="font-display text-6xl md:text-8xl uppercase leading-[0.9] tracking-tight text-white mt-3 break-words"
      >
        {work.title[lang]}
      </h1>
      <p class="text-lg md:text-2xl text-neutral-300 mt-5 max-w-2xl leading-relaxed">
        {work.subtitle[lang]}
      </p>
    </div>
    <span
      class="font-mono text-xs uppercase tracking-widest border border-gold text-gold px-3 py-2 shrink-0"
    >
      [{t.status[work.status]}]
    </span>
  </div>

  <div class="grid md:grid-cols-2 gap-px bg-line border border-line mt-12">
    <div class="bg-black p-6 md:p-8">
      <h2 class="font-mono text-gold text-xs tracking-widest uppercase mb-4">
        {t.problem}
      </h2>
      <p class="text-neutral-200 leading-relaxed">{work.problem[lang]}</p>
    </div>
    <div class="bg-black p-6 md:p-8">
      <h2 class="font-mono text-gold text-xs tracking-widest uppercase mb-4">
        {t.solution}
      </h2>
      <p class="text-neutral-200 leading-relaxed">{work.solution[lang]}</p>
    </div>
  </div>

  <div class="border border-gold p-6 md:p-8 mt-8">
    <h2 class="font-mono text-gold text-xs tracking-widest uppercase mb-4">
      {t.achievement}
    </h2>
    <p class="text-xl md:text-2xl text-white font-bold leading-snug">
      {work.achievement[lang]}
    </p>
  </div>

  <div class="mt-10">
    <h2 class="font-mono text-neutral-500 text-xs tracking-widest uppercase mb-4">
      {t.stack}
    </h2>
    <div class="flex flex-wrap gap-2">
      {
        work.stack.map((tech) => (
          <span class="font-mono text-xs uppercase tracking-wider border border-line px-3 py-2 text-neutral-300 hover:border-gold hover:text-gold transition-colors">
            {tech}
          </span>
        ))
      }
    </div>
  </div>

  {
    work.repo && (
      <a
        href={work.repo}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="inline-flex items-center gap-2 mt-10 font-mono text-sm uppercase tracking-widest text-gold hover:text-white transition-colors"
      >
        [GITHUB] <span class="group-hover:translate-x-1">→</span>
      </a>
    )
  }
</section>
