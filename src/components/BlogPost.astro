---
import type { CollectionEntry } from "astro:content";
import { render, getCollection } from "astro:content";
import { dict, type Lang } from "../i18n/dict";
import { works } from "../data/works";

interface Props {
  post: CollectionEntry<"blog">;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = dict[lang].blog;
const { Content } = await render(post);

const dateFmt = (d: Date) =>
  d.toLocaleDateString(lang === "ru" ? "ru-RU" : "en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const blogHref = lang === "ru" ? "/ru/blog" : "/blog";
const worksHref = lang === "ru" ? "/ru/works" : "/works";

const postSlug = (id: string) => id.replace(/^(en|ru)\//, "");
const slug = postSlug(post.id);
const relatedWork = works.find((w) =>
  w.relatedPosts?.includes(slug),
);

const all = (
  await getCollection("blog", (p) => p.data.lang === lang && !p.data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const idx = all.findIndex((p) => p.id === post.id);
const prev = idx > 0 ? all[idx - 1] : undefined;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : undefined;

const other: Lang = lang === "en" ? "ru" : "en";
const otherHref =
  other === "ru" ? `/ru/blog/${slug}` : `/blog/${slug}`;
---

<article class="container-page py-16 md:py-24 max-w-3xl">
  <div class="flex justify-between items-center">
    <a
      href={blogHref}
      class="font-mono text-sm text-gold hover:text-white transition-colors tracking-widest"
    >
      {t.back}
    </a>
    <a
      href={otherHref}
      class="font-mono text-xs text-neutral-500 hover:text-gold transition-colors uppercase"
    >
      [{other.toUpperCase()}]
    </a>
  </div>

  <div class="font-mono text-xs text-neutral-500 uppercase tracking-widest mt-10">
    {t.published}: <span class="text-gold">{dateFmt(post.data.date)}</span>
  </div>

  <h1
    class="text-3xl md:text-5xl font-bold uppercase leading-tight text-white mt-4 tracking-tight"
  >
    {post.data.title}
  </h1>

  <div class="flex flex-wrap gap-2 mt-6 pb-8 border-b border-line">
    {
      post.data.tags.map((tag) => (
        <a
          href={`${blogHref}/tags/${tag}`}
          class="font-mono text-[10px] text-neutral-500 uppercase tracking-wider border border-line px-2 py-1 hover:border-gold hover:text-gold transition-colors"
        >
          #{tag}
        </a>
      ))
    }
  </div>

  {
    relatedWork && (
      <a
        href={`${worksHref}/${relatedWork.slug}`}
        class="group flex items-center justify-between gap-4 mt-8 border border-line p-5 hover:border-gold transition-colors"
      >
        <span>
          <span class="font-mono text-xs text-gold tracking-widest block mb-2">
            {t.workLabel}
          </span>
          <span class="text-xl font-bold uppercase text-white group-hover:text-gold transition-colors">
            {relatedWork.title[lang]}
          </span>
        </span>
        <span class="font-mono text-xs text-neutral-500 group-hover:text-gold transition-colors shrink-0">
          →
        </span>
      </a>
    )
  }

  <div
    class="prose prose-invert prose-lg max-w-none mt-10
      prose-headings:uppercase prose-headings:font-bold prose-headings:tracking-tight
      prose-h2:text-2xl prose-h3:text-xl
      prose-h2:border-b prose-h2:border-line prose-h2:pb-2
      prose-a:text-gold prose-a:no-underline hover:prose-a:underline
      prose-strong:text-white prose-code:text-gold prose-code:before:content-none prose-code:after:content-none
      prose-code:bg-elevated prose-code:px-1.5 prose-code:py-0.5 prose-code:border prose-code:border-line
      prose-blockquote:border-gold prose-blockquote:text-neutral-200
      prose-li:text-neutral-300 prose-p:text-neutral-300"
  >
    <Content />
  </div>

  {
    (prev || next) && (
      <nav class="border-t border-line mt-14 pt-8 flex justify-between gap-4">
        {prev ? (
          <a
            href={`${blogHref}/${postSlug(prev.id)}`}
            class="group max-w-[45%]"
          >
            <span class="font-mono text-xs text-neutral-500 uppercase tracking-widest block mb-2 group-hover:text-gold transition-colors">
              {t.prev}
            </span>
            <span class="text-sm md:text-lg font-bold uppercase text-white group-hover:text-gold transition-colors">
              {prev.data.title}
            </span>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a
            href={`${blogHref}/${postSlug(next.id)}`}
            class="group max-w-[45%] text-right"
          >
            <span class="font-mono text-xs text-neutral-500 uppercase tracking-widest block mb-2 group-hover:text-gold transition-colors">
              {t.next}
            </span>
            <span class="text-sm md:text-lg font-bold uppercase text-white group-hover:text-gold transition-colors">
              {next.data.title}
            </span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }

  <div class="border-t border-line mt-16 pt-8 flex justify-between font-mono text-xs uppercase tracking-widest">
    <span class="text-neutral-600">AP3X0_WEB // LOG</span>
    <span class="text-neutral-600">{post.data.lang.toUpperCase()}</span>
  </div>
</article>

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    inLanguage: post.data.lang,
    url: new URL(
      `${blogHref}/${slug}`,
      Astro.site ?? Astro.url.origin,
    ).href,
    author: {
      "@type": "Person",
      name: "Evgeny Kantor",
      alternateName: "Ap3x0",
      url: "https://github.com/Ap3x0s",
    },
    publisher: {
      "@type": "Organization",
      name: "AP3X0_WEB",
    },
  })}
>
</script>
