---
import "@fontsource/anton/400.css";
import "@fontsource-variable/inter";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollTelemetry from "../components/ScrollTelemetry.astro";
import { ClientRouter } from "astro:transitions";
import { dict, type Lang } from "../i18n/dict";

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const {
  title,
  description = dict.en.site.description,
  lang = "en",
} = Astro.props;

const t = dict[lang];
const fullTitle = `${title} ${t.site.titleSuffix}`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth scroll-pt-32">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="AP3X0_WEB" />

    <link
      rel="alternate"
      hreflang="en"
      href={new URL(lang === "ru" ? Astro.url.pathname.replace(/^\/ru/, "") || "/" : Astro.url.pathname, Astro.site ?? Astro.url.origin)}
    />
    <link
      rel="alternate"
      hreflang="ru"
      href={new URL(lang === "ru" ? Astro.url.pathname : `/ru${Astro.url.pathname === "/" ? "" : Astro.url.pathname}`, Astro.site ?? Astro.url.origin)}
    />

    <ClientRouter />
  </head>
  <body
    class="min-h-screen flex flex-col bg-background text-foreground font-sans antialiased"
  >
    <Header lang={lang} />
    <main class="flex-1 relative pt-24 md:pt-28">
      <slot />
    </main>
    <Footer lang={lang} />
    <ScrollTelemetry lang={lang} />
  </body>
</html>
