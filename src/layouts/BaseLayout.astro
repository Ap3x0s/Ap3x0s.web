---
import "@fontsource/anton/400.css";
import "@fontsource-variable/inter";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollTelemetry from "../components/ScrollTelemetry.astro";
import { ClientRouter } from "astro:transitions";
import { dict, type Lang } from "../i18n/dict";

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const {
  title,
  description = dict.en.site.description,
  lang = "en",
} = Astro.props;

const t = dict[lang];
const fullTitle = `${title} ${t.site.titleSuffix}`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth scroll-pt-32">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link
      rel="canonical"
      href={new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="AP3X0_WEB" />
    <meta
      property="og:image"
      content={new URL("/og.png", Astro.site ?? Astro.url.origin).href}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:image"
      content={new URL("/og.png", Astro.site ?? Astro.url.origin).href}
    />

    <link
      rel="alternate"
      hreflang="en"
      href={new URL(lang === "ru" ? Astro.url.pathname.replace(/^\/ru/, "") || "/" : Astro.url.pathname, Astro.site ?? Astro.url.origin)}
    />
    <link
      rel="alternate"
      hreflang="ru"
      href={new URL(lang === "ru" ? Astro.url.pathname : `/ru${Astro.url.pathname === "/" ? "" : Astro.url.pathname}`, Astro.site ?? Astro.url.origin)}
    />

    <ClientRouter />
  </head>
  <body
    class="min-h-screen flex flex-col bg-background text-foreground font-sans antialiased"
  >
    <a href="#main" class="skip-link">Skip to content</a>
    <Header lang={lang} />
    <main id="main" class="flex-1 relative pt-24 md:pt-28">
      <slot />
    </main>
    <Footer lang={lang} />
    <ScrollTelemetry lang={lang} />

    <script is:inline>
      (() => {
        if (window.__ap3x0) return;
        window.__ap3x0 = true;

        console.log(
          "%c █████╗ ██████╗ ██████╗ ██╗  ██╗ ██████╗ \n" +
            "██╔══██╗██╔══██╗╚════██╗╚██╗██╔╝██╔═████╗\n" +
            "███████║██████╔╝ █████╔╝ ╚███╔╝ ██║██╔██║\n" +
            "██╔══██║██╔═══╝ ╚═══██╗ ██╔██╗ ████╔╝██║\n" +
            "██║  ██║██║     ██████╔╝██╔╝ ██╗╚██████╔╝\n" +
            "╚═╝  ╚═╝╚═╝     ╚═════╝ ╚═╝  ╚═╝ ╚═════╝ ",
          "color:#FFC800;font-family:monospace;font-size:11px;line-height:1.15;"
        );
        console.log(
          "%cAP3X0_WEB_SYSTEM // local-first portfolio. zero telemetry, zero cloud.",
          "color:#d4d4d4;font-family:monospace;font-size:12px;"
        );
        console.log(
          "%clooking for an engineer? -> /contacts   |   keyboard: g then h/w/a/l/c/d",
          "color:#737373;font-family:monospace;font-size:12px;"
        );

        let gAt = 0;
        const paths = {
          h: "/",
          w: "/works",
          a: "/about",
          l: "/blog",
          c: "/contacts",
          d: "/decisions",
        };
        document.addEventListener("keydown", (e) => {
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          const tag = (e.target && e.target.tagName) || "";
          if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;
          const key = e.key.toLowerCase();
          if (key === "g") {
            gAt = Date.now();
            return;
          }
          const path = paths[key];
          if (!path || Date.now() - gAt > 900) return;
          gAt = 0;
          const ru =
            location.pathname === "/ru" ||
            location.pathname.startsWith("/ru/");
          const a = document.createElement("a");
          a.href = (ru ? "/ru" : "") + path;
          document.body.appendChild(a);
          a.click();
          setTimeout(() => a.remove(), 0);
        });
      })();
    </script>
  </body>
</html>
